# İlk Yönetici (Admin) Bilgileri
DEFAULT_ADMIN_EMAIL=admin@senadizinet.com
DEFAULT_ADMIN_PASSWORD=SenaDizi2026!
DEFAULT_ADMIN_NAME=SenaDizi Admin

# Video & CDN Sağlayıcıları (Cloudflare Stream, Bunny.net, AWS S3 / CloudFront, Vimeo Pro vb.)
CDN_BASE_URL=
VIDEO_STORAGE_PROVIDER=external

# Ödeme Sağlayıcıları & Webhook (Stripe, Iyzico, PayTR)
