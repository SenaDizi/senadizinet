# SenaDizi Konfigürasyon Dosyası
APP_NAME=SenaDizi
APP_ENV=development
SECRET_KEY=senadizinet-super-secret-production-key-change-this-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Veritabanı (Varsayılan: SQLite, PostgreSQL için: postgresql://user:password@localhost/senadizinet)
